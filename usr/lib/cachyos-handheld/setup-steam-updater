#!/usr/bin/python
"""Register the updater through Steam, once per local Steam account."""

import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

import vdf


LAUNCHER = "/usr/share/applications/cachyos-handheld-update.desktop"
EXECUTABLE = "/usr/bin/cachyos-handheld-update"
STEAM_ID_BASE = 76561197960265728


def lowercase_keys(value):
    if isinstance(value, dict):
        return {key.lower(): lowercase_keys(item) for key, item in value.items()}
    return value


def read_text_vdf(path):
    with path.open(encoding="utf-8") as stream:
        return lowercase_keys(vdf.load(stream))


def steam_process(home):
    pid = int((home / ".steam/steam.pid").read_text())
    process = Path("/proc") / str(pid)
    if process.stat().st_uid != os.getuid() or process.joinpath("comm").read_text().strip() != "steam":
        return None
    fields = process.joinpath("stat").read_text().rsplit(")", 1)[1].split()
    ticks = int(fields[19])
    boot_time = next(int(line.split()[1]) for line in Path("/proc/stat").read_text().splitlines()
                     if line.startswith("btime "))
    boot_id = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    return f"{boot_id}:{pid}:{ticks}", boot_time + ticks / os.sysconf("SC_CLK_TCK")


def active_account(home, root, started):
    users = read_text_vdf(root / "config/loginusers.vdf")["users"]
    registry = read_text_vdf(home / ".steam/registry.vdf")
    steam = registry["registry"]["hkcu"]["software"]["valve"]["steam"]
    name = steam.get("autologinuser", "").lower()
    for steam_id, user in users.items():
        selected = user.get("accountname", "").lower() == name if name else user.get("mostrecent") == "1"
        # A remembered account alone does not mean this Steam launch has logged in.
        if not selected or int(user.get("timestamp", "0")) < int(started):
            continue
        account = int(steam_id) - STEAM_ID_BASE
        if 0 < account < 2**32 and root.joinpath("userdata", str(account), "config").is_dir():
            return str(account)
    return None


def has_updater(path):
    if not path.exists():
        return False
    with path.open("rb") as stream:
        shortcuts = lowercase_keys(vdf.binary_load(stream))["shortcuts"]
    return any(item.get("exe", "").strip('"') == EXECUTABLE
               or item.get("shortcutpath") == LAUNCHER for item in shortcuts.values())


def save_state(path, value):
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as stream:
        temporary = Path(stream.name)
        try:
            json.dump(value, stream)
            stream.flush()
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)


def setup(home, state_dir):
    process = steam_process(home)
    if process is None:
        return
    launch, started = process
    root = home / ".steam/steam"
    account = active_account(home, root, started)
    if account is None:
        return
    state_file = state_dir / f"{account}.json"
    state = json.loads(state_file.read_text()) if state_file.exists() else {}
    if state.get("registered"):
        return  # Respect a shortcut the user subsequently removes.
    if has_updater(root / "userdata" / account / "config/shortcuts.vdf"):
        save_state(state_file, {"registered": True})
        return
    if state.get("requested_launch") == launch:
        return  # Steam may not have saved its shortcut database yet.
    if steam_process(home) != process or active_account(home, root, started) != account:
        return
    subprocess.run(["/usr/bin/steamos-add-to-steam", LAUNCHER], check=True, timeout=10)
    # Only mark registration complete after Steam's own database confirms it.
    save_state(state_file, {"requested_launch": launch})


def main():
    if os.getuid() == 0:
        return 1
    home = Path.home()
    state_dir = Path(os.environ.get("XDG_STATE_HOME", home / ".local/state")) / "cachyos-handheld/steam-updater"
    state_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    with state_dir.joinpath(".lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        try:
            setup(home, state_dir)
        except FileNotFoundError:
            return 0  # Steam is not installed, is starting, or has just exited.
        except (OSError, ValueError, KeyError, SyntaxError, subprocess.SubprocessError) as error:
            print(f"Updater shortcut setup deferred: {type(error).__name__}", file=sys.stderr)
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
