# LED color write access
SUBSYSTEM=="leds", TEST=="/sys/class/leds/%k/brightness", RUN+="/usr/bin/chown 1000:1000 '/sys/class/leds/%k/brightness'"
SUBSYSTEM=="leds", TEST=="/sys/class/leds/%k/effect", RUN+="/usr/bin/chown 1000:1000 '/sys/class/leds/%k/effect'"
SUBSYSTEM=="leds", TEST=="/sys/class/leds/%k/enabled", RUN+="/usr/bin/chown 1000:1000 '/sys/class/leds/%k/enabled'"
SUBSYSTEM=="leds", TEST=="/sys/class/leds/%k/mode", RUN+="/usr/bin/chown 1000:1000 '/sys/class/leds/%k/mode'"
SUBSYSTEM=="leds", TEST=="/sys/class/leds/%k/multi_intensity", RUN+="/usr/bin/chown 1000:1000 '/sys/class/leds/%k/multi_intensity'"
SUBSYSTEM=="leds", TEST=="/sys/class/leds/%k/profile", RUN+="/usr/bin/chown 1000:1000 '/sys/class/leds/%k/profile'"
SUBSYSTEM=="leds", TEST=="/sys/class/leds/%k/speed", RUN+="/usr/bin/chown 1000:1000 '/sys/class/leds/%k/speed'"
